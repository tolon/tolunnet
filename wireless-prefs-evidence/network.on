ECHO "Starting network..." NOLINE

; start wireless manager
IF EXISTS ENV:Sys/Wireless.prefs
   IF EXISTS DEVS:Networks/wifipi.device
      Run C:WirelessManager DEVICE="wifipi.device" UNIT=0 CONFIG="ENVARC:Sys/Wireless.prefs"
   ELSE
      IF EXISTS DEVS:Networks/prism2.device
         C:WirelessManager prism2.device
         wait 5
      ENDIF
   ENDIF
ENDIF


; start Roadshow
IF $AmiKitNetwork EQ "1"
   C:WaitUntilConnected DEVICE="DEVS:Networks/wifipi.device" UNIT=0 DELAY=100
   IF NOT WARN
      Run <>NIL: C:NetLogViewer CX_POPUP=NO
      C:AddNetInterface DEVS:NetInterfaces/WiFiPi
   ELSE
      ECHO "Wireless Manager failed!"
   ENDIF
ELSE
   RequestChoice >ENV:netsetup "Network" "Internet has not been set up yet.*n*nDo you want to set it up now?" "Yes|Later"
   IF $netsetup EQ "1"
      CD SYS:Prefs/Presets/AmiKit/Zeus/Wizards
      Execute >NIL: NetworkWizard
   ENDIF
ENDIF

; start msInternetStatus
CxCtrl NAME msIntenetStatus
IF $RC EQ "5"
   IF EXISTS SYS:WBStartup/msInternetStatus
      WBStarter SYS:WBStartup/msInternetStatus
   ELSE
      IF EXISTS SYS:WBStartup/Disabled/msInternetStatus
         WBStarter SYS:WBStartup/Disabled/msInternetStatus
      ENDIF
   ENDIF
ENDIF

; reawake smbfs-shares
; requires smbfs 1.182 and mounted from CLI with option SETENV
If EXISTS ENV:smbfs-process
  List ENV:smbfs-process/#? LFORMAT="Break ${ENV:smbfs-process/%s} E" TO=T:smbfs-awake
  Execute T:smbfs-awake
  Delete T:smbfs-awake QUIET
EndIf

ECHO "Done! Check the Network status on the screen bar."
ECHO "If it doesn't say 'Online', try restarting the network again."
