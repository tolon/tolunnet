# Build artefacts
/build/
/obj/
*.o
*.a
*.uo
*.exe

# Amiga build outputs
*.elf
*.hunk
*.lha

# lwIP vendored from a clean release; no per-user junk inside it
vendor/lwip/**/*.o
vendor/lwip/**/*.orig
vendor/lwip/**/.git/

# Python
__pycache__/
*.pyc

# Editor / OS
*~
.*.swp
.DS_Store
Thumbs.db

# Local toolchain / env
.env
.env.*

# Intermediate dirty bench logs
docs/bench-logs/*-dirty/


# Debugger/scratch artifacts (CLOSE §A.4)
.dbg-*
.uae-*
.zoom-*
.hunt*
.capture*
.wsl-*
.postkey*
.linktest*
