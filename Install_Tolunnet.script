; tolunnet - Official AmigaOS Installation Script
; Commodore Installer 43.x, AmigaOS 3.0+, 68000 or higher.
; The script lives in the package root; all source paths are relative
; to it (C/, Libs/, TolunnetPrefs, TolunnetSetup).
;
; GUI discipline (10a-3): welcome takes plain strings, every (message)
; and the wizard offer are gated on @user-level so novice installs
; never open a window, copyfiles destinations are directories, and a
; note is written for novice runs instead of asking.

(welcome
  "Welcome to the tolunnet TCP/IP Stack Installation.\n\ntolunnet is a lightweight TCP/IP stack and bsdsocket.library v4.1 implementation for the Commodore Amiga.\n\nAuthor: Tolon\nRequirements: AmigaOS 3.0+, 68000 or higher CPU, SANA-II network driver.\n"
)

(if (> @user-level 0)
  (message "Installing tolunnet binaries to SYS:C/ ...")
)

; ---- first install: back up the C: tools we are about to replace -------
; (reinstall: S:tolunnet-undo already exists -> keep the original
; backups and the original undo) ------------------------------------------
(if (not (exists "S:tolunnet-undo" (noreq)))
  (if (not (exists "SYS:Storage/tolunnet-backup" (noreq)))
    (makedir "SYS:Storage/tolunnet-backup")
  )
  (if (not (exists "SYS:Storage/tolunnet-backup/C" (noreq)))
    (makedir "SYS:Storage/tolunnet-backup/C")
  )
;BEGIN GENERATED-BACKUP (scripts/gen_installer.py - do not edit)
; first install only: preserve whatever we are about to
; replace, and note what we create from scratch
  (if (exists "SYS:C/tolunnet" (noreq))
    (if (not (exists "SYS:Storage/tolunnet-backup/C/tolunnet" (noreq)))
      (copyfiles (source "SYS:C/tolunnet") (dest "SYS:Storage/tolunnet-backup/C") (newname "tolunnet"))
    )
  )
  (if (exists "SYS:C/TolunnetControl" (noreq))
