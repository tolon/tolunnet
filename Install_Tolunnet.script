; tolunnet - Official AmigaOS Installation Script
; Commodore Installer 43.x, AmigaOS 3.0+, 68000 or higher.
; The script lives in the package root; all source paths are relative
; to it (C/, Libs/, TolunnetPrefs, TolunnetSetup).
;
; GUI discipline (10a-3): welcome takes plain strings, every (message)
; and the wizard offer are gated on @user-level so novice installs
; never open a window, copyfiles destinations are directories, and a
; note is written for novice runs instead of asking.

;BEGIN GENERATED-WELCOME (scripts/gen_installer.py - do not edit;
; the version comes from include/version.h)
(welcome
  "Welcome to the tolunnet 1.2.0-rc5 Installation.\n\nThe tolunnet package installs a TCP/IP stack and bsdsocket.library v4.1 runtime for AmigaOS 3.0 or newer on 68000-class Amigas.\n\nAuthor: Ismail Ozturk (tolon)\n"
)
; 11ab item 2b: refuse to run on anything older than OS 3.0.
; 11ac item 1: Installer has no infix operators - shiftleft, not <<.
(if (< (getversion "exec.library" (resident)) (shiftleft 39 16))
  (abort "tolunnet needs AmigaOS 3.0 (exec.library V39) or newer. Installation aborted.")
)
;END GENERATED-WELCOME

(if (> @user-level 0)
  (message "Installing tolunnet binaries to SYS:C/ ...")
)

;BEGIN GENERATED-PREPARE (scripts/gen_installer.py - do not edit)
; bugtrack 2026-10-02 1.5: S:tolunnet-undo is written FIRST,
; before any backup, copy, rename or delete, so an aborted
; install can always be undone. The undo only deletes a
; file a new/ marker says tolunnet created (1.7).
; Installer (if) takes ONE then and ONE else statement - no
; multi-statement bodies (the old S:tolunnet-undo gate had 35).
(set #tn-had-undo (exists "S:tolunnet-undo" (noreq)))
; an install from before the markers (undo, but no new/ dir):
; every un-backed-up SYS:C file is tolunnet's own
(set #tn-legacy 0)
(if #tn-had-undo
  (if (not (exists "SYS:Storage/tolunnet-backup/new" (noreq)))
    (set #tn-legacy 1)
  )
)
(textfile
  (dest "S:tolunnet-undo")
    (append (cat "; tolunnet-undo - remove tolunnet and restore the previous stack\n"
          ";BEGIN GENERATED-UNDO\n"
          "FailAt 21\n"
          "; the setup wizard keeps its own restore script - it runs first\n"
          "If EXISTS S:tolunnet-undo-stacks\n"
          "  Execute S:tolunnet-undo-stacks\n"
          "  If EXISTS S:tolunnet-undo-stacks\n"
          "    Delete >NIL: S:tolunnet-undo-stacks QUIET\n"
          "  EndIf\n"
          "EndIf\n"
          "; restore what we replaced, delete only what we created\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/tolunnet\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/tolunnet SYS:C/tolunnet CLONE\n"
          "  If WARN\n"
          "    Echo tolunnet-undo: SYS:C/tolunnet not restored, the original stays in SYS:Storage/tolunnet-backup/C\n"
          "  Else\n"
          "    Delete >NIL: SYS:Storage/tolunnet-backup/C/tolunnet QUIET\n"
          "  EndIf\n"
          "Else\n"
          "  If EXISTS SYS:Storage/tolunnet-backup/new/tolunnet\n"
          "    If EXISTS SYS:C/tolunnet\n"
