; ---- boot line: stack size + daemon. Guarded by If EXISTS so
; ---- a block the undo leaves behind does nothing (1.3) -----
(startup "tolunnet"
  (prompt "Add tolunnet to S:User-Startup (start the stack at boot)?")
  (help "Writes Stack 32768 and Run <NIL: >NIL: C:tolunnet into S:User-Startup so the stack starts on every boot.")
  (command "If EXISTS C:tolunnet\nStack 32768\nRun <NIL: >NIL: C:tolunnet\nEndIf")
)
;END GENERATED-FINISH

; ---- first-run configuration: no placeholder config is written. The
; ---- wizard configures the network: novice runs it directly, other
; ---- levels are asked (default Yes). -------------------------------
(set #run-setup 0)
(if (= @user-level 0)
  (set #run-setup 1)
)
(if (> @user-level 0)
  (set #run-setup
    (askbool
      (prompt "Run SYS:Prefs/TolunnetSetup now to configure your network? (You can start it any time later from SYS:Prefs.)")
      (default 1)
      (help "tolunnet needs a device configuration before it can run; the setup wizard detects hardware, wireless and address settings.")
    )
  )
)
(if (= #run-setup 1)
  (run "SYS:Prefs/TolunnetSetup")
)

(if (exists "DEVS:tolunnet.config" (noreq))
  (exit "tolunnet installation complete. The stack starts automatically at next boot.")
)
(if (not (exists "DEVS:tolunnet.config" (noreq)))
  (exit "Network not configured yet - run SYS:Prefs/TolunnetSetup.")
)
