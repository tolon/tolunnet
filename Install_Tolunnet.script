(if (> @user-level 0)
  (message "Installing usergroup.library to SYS:Libs/ ...")
)
(copylib (source "Libs/usergroup.library") (dest "SYS:Libs"))

(if (> @user-level 0)
  (message "Installing preference tools to SYS:Prefs/ ...")
)
(copyfiles (source "TolunnetPrefs") (dest "SYS:Prefs"))
(copyfiles (source "TolunnetSetup") (dest "SYS:Prefs"))

; ---- replace an existing bsdsocket.library: back it up first, and
; ---- delete the original only once the backup exists ------------------
(if (exists "LIBS:bsdsocket.library" (noreq))
  (if (not (exists "LIBS:bsdsocket.library.pre-tolunnet" (noreq)))
    (run "Copy >NIL: LIBS:bsdsocket.library LIBS:bsdsocket.library.pre-tolunnet CLONE")
  )
)
(if (exists "LIBS:bsdsocket.library.pre-tolunnet" (noreq))
  (run "Delete >NIL: LIBS:bsdsocket.library QUIET")
)

; ---- undo script + User-Startup backup ---------------------------------
(if (exists "S:User-Startup" (noreq))
  (if (not (exists "S:User-Startup.tolunnet-bak" (noreq)))
    (run "Copy >NIL: S:User-Startup S:User-Startup.tolunnet-bak CLONE")
  )
)
(run "Delete >NIL: S:tolunnet-undo QUIET")
(textfile
  (dest "S:tolunnet-undo")
    (append (cat "; tolunnet-undo - remove tolunnet and restore the previous stack\n"
          ";BEGIN GENERATED-UNDO (scripts/gen_installer.py - do not edit)\n"
          "; restore what we replaced, remove what we created\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/tolunnet\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/tolunnet SYS:C/tolunnet CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/tolunnet QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/TolunnetControl\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/TolunnetControl SYS:C/TolunnetControl CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/TolunnetControl QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/ping\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/ping SYS:C/ping CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/ping QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/ifconfig\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/ifconfig SYS:C/ifconfig CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/ifconfig QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/netstat\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/netstat SYS:C/netstat CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/netstat QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/route\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/route SYS:C/route CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/route QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/AddNetRoute\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/AddNetRoute SYS:C/AddNetRoute CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/AddNetRoute QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/DeleteNetRoute\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/DeleteNetRoute SYS:C/DeleteNetRoute CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/DeleteNetRoute QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/AddNetInterface\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/AddNetInterface SYS:C/AddNetInterface CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/AddNetInterface QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/ConfigureNetInterface\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/ConfigureNetInterface SYS:C/ConfigureNetInterface CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/ConfigureNetInterface QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/Online\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/Online SYS:C/Online CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/Online QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/Offline\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/Offline SYS:C/Offline CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/Offline QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/CheckNetConfig\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/CheckNetConfig SYS:C/CheckNetConfig CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/CheckNetConfig QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/NetShutdown\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/NetShutdown SYS:C/NetShutdown CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/NetShutdown QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/wget\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/wget SYS:C/wget CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/wget QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/curl\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/curl SYS:C/curl CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/curl QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/iperf\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/iperf SYS:C/iperf CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/iperf QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/tftp\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/tftp SYS:C/tftp CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/tftp QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/ftp\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/ftp SYS:C/ftp CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/ftp QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/hostname\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/hostname SYS:C/hostname CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/hostname QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/nslookup\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/nslookup SYS:C/nslookup CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/nslookup QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/whois\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/whois SYS:C/whois CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/whois QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/traceroute\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/traceroute SYS:C/traceroute CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/traceroute QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/nc\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/nc SYS:C/nc CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/nc QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/arp\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/arp SYS:C/arp CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/arp QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/sntp\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/sntp SYS:C/sntp CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/sntp QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/telnet\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/telnet SYS:C/telnet CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/telnet QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/GetNetStatus\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/GetNetStatus SYS:C/GetNetStatus CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/GetNetStatus QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/ShowNetStatus\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/ShowNetStatus SYS:C/ShowNetStatus CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/ShowNetStatus QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/TolunnetPing\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/TolunnetPing SYS:C/TolunnetPing CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/TolunnetPing QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/TolunnetStatus\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/TolunnetStatus SYS:C/TolunnetStatus CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/TolunnetStatus QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/TolunnetGet\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/TolunnetGet SYS:C/TolunnetGet CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/TolunnetGet QUIET\n"
          "EndIf\n"
          "If EXISTS SYS:Storage/tolunnet-backup/C/TestSocket\n"
          "  Copy >NIL: SYS:Storage/tolunnet-backup/C/TestSocket SYS:C/TestSocket CLONE\n"
          "Else\n"
          "  Delete >NIL: SYS:C/TestSocket QUIET\n"
          "EndIf\n"
          ";END GENERATED-UNDO\n"
          "If EXISTS S:User-Startup.tolunnet-bak\n"
          "  Copy >NIL: S:User-Startup.tolunnet-bak S:User-Startup CLONE\n"
          "EndIf\n"
          "If EXISTS LIBS:bsdsocket.library.pre-tolunnet\n"
          "  Copy >NIL: LIBS:bsdsocket.library.pre-tolunnet LIBS:bsdsocket.library CLONE\n"
          "  Delete >NIL: LIBS:bsdsocket.library.pre-tolunnet QUIET\n"
          "EndIf\n"
          "Delete >NIL: DEVS:tolunnet.config QUIET\n"
          "Delete >NIL: SYS:Storage/tolunnet-backup ALL QUIET\n"
          "Run >NIL: Delete S:tolunnet-undo QUIET\n"
    )
  )
)

; ---- boot line: stack size + daemon ------------------------------------
(startup "tolunnet"
  (prompt "Add tolunnet to S:User-Startup (start the stack at boot)?")
  (help "Writes Stack 32768 and Run <NIL: >NIL: C:tolunnet into S:User-Startup so the stack starts on every boot.")
  (command "Stack 32768\nRun <NIL: >NIL: C:tolunnet")
)

; ---- first-run configuration: no placeholder config is written. The
; ---- wizard configures the network: novice runs it directly, other
; ---- levels are asked (default Yes). -------------------------------
(set #run-setup 0)
(if (= @user-level 0)
  (set #run-setup 1)
)
(if (> @user-level 0)
  (set #run-setup
    (askbool
      (prompt "Run SYS:Prefs/TolunnetSetup now to configure your network? (You can start it any time later from SYS:Prefs.)")
      (default 1)
      (help "tolunnet needs a device configuration before it can run; the setup wizard detects hardware, wireless and address settings.")
    )
  )
)
(if (= #run-setup 1)
  (execute "SYS:Prefs/TolunnetSetup")
)

(if (exists "DEVS:tolunnet.config" (noreq))
  (exit "tolunnet installation complete. The stack starts automatically at next boot." (quiet))
)
(if (not (exists "DEVS:tolunnet.config" (noreq)))
  (exit "Network not configured yet - run SYS:Prefs/TolunnetSetup." (quiet))
)
