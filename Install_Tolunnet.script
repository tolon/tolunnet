; tolunnet — Official AmigaOS Installation Script
; Compatible with Commodore Installer 43.x / AmigaOS 3.0+

(transcript "T:tolunnet_install.log")

(welcome
  (text "Welcome to the tolunnet TCP/IP Stack Installation.\n\n"
        "tolunnet is a lightweight, high-performance SANA-II TCP/IP stack\n"
        "and bsdsocket.library v4.1 implementation for Commodore Amiga.\n\n"
        "Author: Tolon\n"
        "Requirements: AmigaOS 3.0+, 68020+ CPU, SANA-II Network Driver.")
)

(set @default-dest "SYS:")

(set #device-name
  (askstring
    (prompt "Enter the SANA-II device name for your network card:\n"
            "(e.g. ethernet.device, cnet.device, ariadne.device, 3c589.device)")
    (default "ethernet.device")
  )
)

(set #unit-num
  (asknumber
    (prompt "Enter the SANA-II unit number (usually 0):")
    (default 0)
    (range 0 16)
  )
)

(set #ip-mode
  (askchoice
    (prompt "Select network address configuration method:")
    (choices "Automatic configuration via DHCP (Recommended)"
             "Static IP configuration (Manual)")
    (default 0)
  )
)

(if (= #ip-mode 1)
  (set #static-ip (askstring (prompt "Enter Static IP address:") (default "192.168.1.100")))
  (set #static-nm (askstring (prompt "Enter Subnet Mask:") (default "255.255.255.0")))
  (set #static-gw (askstring (prompt "Enter Default Gateway:") (default "192.168.1.1")))
)

(message "Installing tolunnet system binaries to SYS:C/ ...")

(copylib
  (source "C/tolunnet")
  (dest "SYS:C")
  (confirm)
)

(copylib
  (source "C/TolunnetPing")
  (dest "SYS:C")
  (confirm)
)

(copylib
  (source "C/TolunnetGet")
  (dest "SYS:C")
  (confirm)
)

(copylib
  (source "C/TolunnetStatus")
  (dest "SYS:C")
  (confirm)
)

(run "Delete >NIL: SYS:Prefs/TolunnetPrefs ALL FORCE QUIET")
(run "Delete >NIL: SYS:Prefs/TolunnetPrefs.info FORCE QUIET")

(copylib
  (source "TolunnetPrefs")
  (dest "SYS:Prefs")
  (infos)
  (confirm)
)

(run "Copy TolunnetPrefs.info SYS:Prefs/TolunnetPrefs.info CLONE QUIET")

; -------------------------------------------------------------
; Stack backup & non-destructive migration (Item 4b)
; -------------------------------------------------------------
(set #stack-suffix "pre-tolunnet")
(if (exists "DEVS:NetInterfaces")
  (set #stack-suffix "roadshow")
)
(if (exists "Miami:")
  (set #stack-suffix "miami")
)
(if (exists "AmiTCP:")
  (set #stack-suffix "amitcp")
)

(if (exists "LIBS:bsdsocket.library")
  (action
    (message "Existing bsdsocket.library detected. Backing up...")
    (run (cat "Copy LIBS:bsdsocket.library LIBS:bsdsocket.library." #stack-suffix " CLONE QUIET"))
    (run "Delete LIBS:bsdsocket.library FORCE QUIET")
  )
)

(if (exists "S:User-Startup")
  (action
    (if (not (exists "S:User-Startup.tolunnet-bak"))
      (run "Copy S:User-Startup S:User-Startup.tolunnet-bak CLONE QUIET")
    )
  )
)

; Write S:tolunnet-undo restoration script
(textfile
  (dest "S:tolunnet-undo")
  (append
    "; tolunnet-undo — restores previous TCP/IP stack\n"
    "FailAt 21\n"
    "IF EXISTS S:User-Startup.tolunnet-bak\n"
    "  Copy S:User-Startup.tolunnet-bak S:User-Startup CLONE QUIET\n"
    "ENDIF\n"
    (cat "IF EXISTS LIBS:bsdsocket.library." #stack-suffix "\n")
    (cat "  Copy LIBS:bsdsocket.library." #stack-suffix " LIBS:bsdsocket.library CLONE QUIET\n")
    (cat "  Delete LIBS:bsdsocket.library." #stack-suffix " QUIET\n")
    "ENDIF\n"
    "IF EXISTS LIBS:bsdsocket.library.pre-tolunnet\n"
    "  Copy LIBS:bsdsocket.library.pre-tolunnet LIBS:bsdsocket.library CLONE QUIET\n"
    "  Delete LIBS:bsdsocket.library.pre-tolunnet QUIET\n"
    "ENDIF\n"
    "Delete >NIL: DEVS:tolunnet.config QUIET\n"
    "Echo \"Previous TCP/IP stack configuration restored.\"\n"
  )
)
(run "Protect S:tolunnet-undo +s +e QUIET")

(if (= #ip-mode 0)
  (textfile
    (dest "DEVS:tolunnet.config")
    (append
      (cat "DEVICE=" #device-name "\n")
      (cat "UNIT=" #unit-num "\n")
      "DHCP=YES\n"
    )
  )
  (textfile
    (dest "DEVS:tolunnet.config")
    (append
      (cat "DEVICE=" #device-name "\n")
      (cat "UNIT=" #unit-num "\n")
      "DHCP=NO\n"
      (cat "IP=" #static-ip "\n")
      (cat "NETMASK=" #static-nm "\n")
      (cat "GATEWAY=" #static-gw "\n")
    )
  )
)

(set #startup-line "Run <NIL: >NIL: C:tolunnet")

(startup "tolunnet"
  (prompt "Add tolunnet network stack to your S:User-Startup?")
  (help "This will automatically start tolunnet every time your Amiga boots.")
  (command #startup-line)
)

(complete
  (text "tolunnet installation is complete!\n\n"
        "You can configure settings at any time using SYS:Prefs/TolunnetPrefs\n"
        "and view documentation by opening README.guide with MultiView.\n\n"
        "Reboot your Amiga to start using the network stack.")
)
