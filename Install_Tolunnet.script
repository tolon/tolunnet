; tolunnet - Official AmigaOS Installation Script
; Commodore Installer 43.x, AmigaOS 3.0+, 68000 or higher.
; The script lives in the package root; all source paths are relative
; to it (C/, Libs/, TolunnetPrefs, TolunnetSetup).
;
; GUI discipline (10a-3): welcome takes plain strings, every (message)
; and the wizard offer are gated on @user-level so novice installs
; never open a window, copyfiles destinations are directories, and a
; note is written for novice runs instead of asking.

(welcome
  "Welcome to the tolunnet TCP/IP Stack Installation.\n\ntolunnet is a lightweight TCP/IP stack and bsdsocket.library v4.1 implementation for the Commodore Amiga.\n\nAuthor: Tolon\nRequirements: AmigaOS 3.0+, 68000 or higher CPU, SANA-II network driver.\n"
)

(if (> @user-level 0)
  (message "Installing tolunnet binaries to SYS:C/ ...")
)

(copyfiles (source "C/tolunnet") (dest "SYS:C"))
(copyfiles (source "C/TolunnetControl") (dest "SYS:C"))
(copyfiles (source "C/ping") (dest "SYS:C"))
(copyfiles (source "C/TolunnetPing") (dest "SYS:C"))
(copyfiles (source "C/ifconfig") (dest "SYS:C"))
(copyfiles (source "C/netstat") (dest "SYS:C"))
(copyfiles (source "C/TolunnetStatus") (dest "SYS:C"))
(copyfiles (source "C/route") (dest "SYS:C"))
(copyfiles (source "C/AddNetRoute") (dest "SYS:C"))
(copyfiles (source "C/DeleteNetRoute") (dest "SYS:C"))
(copyfiles (source "C/AddNetInterface") (dest "SYS:C"))
(copyfiles (source "C/ConfigureNetInterface") (dest "SYS:C"))
(copyfiles (source "C/Online") (dest "SYS:C"))
(copyfiles (source "C/Offline") (dest "SYS:C"))
(copyfiles (source "C/CheckNetConfig") (dest "SYS:C"))
(copyfiles (source "C/NetShutdown") (dest "SYS:C"))
(copyfiles (source "C/wget") (dest "SYS:C"))
(copyfiles (source "C/curl") (dest "SYS:C"))
(copyfiles (source "C/TolunnetGet") (dest "SYS:C"))
(copyfiles (source "C/iperf") (dest "SYS:C"))
(copyfiles (source "C/tftp") (dest "SYS:C"))
(copyfiles (source "C/ftp") (dest "SYS:C"))
(copyfiles (source "C/hostname") (dest "SYS:C"))
(copyfiles (source "C/nslookup") (dest "SYS:C"))
(copyfiles (source "C/whois") (dest "SYS:C"))
(copyfiles (source "C/traceroute") (dest "SYS:C"))
(copyfiles (source "C/nc") (dest "SYS:C"))
(copyfiles (source "C/arp") (dest "SYS:C"))
(copyfiles (source "C/sntp") (dest "SYS:C"))
(copyfiles (source "C/telnet") (dest "SYS:C"))
(copyfiles (source "C/GetNetStatus") (dest "SYS:C"))
(copyfiles (source "C/ShowNetStatus") (dest "SYS:C"))
(copyfiles (source "C/TestSocket") (dest "SYS:C"))

(if (> @user-level 0)
  (message "Installing usergroup.library to SYS:Libs/ ...")
)
(copylib (source "Libs/usergroup.library") (dest "SYS:Libs"))

(if (> @user-level 0)
  (message "Installing preference tools to SYS:Prefs/ ...")
)
(copyfiles (source "TolunnetPrefs") (dest "SYS:Prefs"))
(copyfiles (source "TolunnetSetup") (dest "SYS:Prefs"))

; ---- replace an existing bsdsocket.library: back it up first, and
; ---- delete the original only once the backup exists ------------------
(if (exists "LIBS:bsdsocket.library" (noreq))
  (if (not (exists "LIBS:bsdsocket.library.pre-tolunnet" (noreq)))
    (run "Copy >NIL: LIBS:bsdsocket.library LIBS:bsdsocket.library.pre-tolunnet CLONE")
  )
)
(if (exists "LIBS:bsdsocket.library.pre-tolunnet" (noreq))
  (run "Delete >NIL: LIBS:bsdsocket.library QUIET")
)

; ---- undo script + User-Startup backup ---------------------------------
(if (exists "S:User-Startup" (noreq))
  (if (not (exists "S:User-Startup.tolunnet-bak" (noreq)))
    (run "Copy >NIL: S:User-Startup S:User-Startup.tolunnet-bak CLONE")
  )
)
(textfile
  (dest "S:tolunnet-undo")
  (append "; tolunnet-undo - remove tolunnet and restore the previous stack\nIf EXISTS S:User-Startup.tolunnet-bak\n  Copy >NIL: S:User-Startup.tolunnet-bak S:User-Startup CLONE\nEndIf\nIf EXISTS LIBS:bsdsocket.library.pre-tolunnet\n  Copy >NIL: LIBS:bsdsocket.library.pre-tolunnet LIBS:bsdsocket.library CLONE\n  Delete >NIL: LIBS:bsdsocket.library.pre-tolunnet QUIET\nEndIf\nDelete >NIL: DEVS:tolunnet.config QUIET\n")
)

; ---- boot line: stack size + daemon ------------------------------------
(startup "tolunnet"
  (prompt "Add tolunnet to S:User-Startup (start the stack at boot)?")
  (help "Writes Stack 32768 and Run <NIL: >NIL: C:tolunnet into S:User-Startup so the stack starts on every boot.")
  (command "Stack 32768\nRun <NIL: >NIL: C:tolunnet")
)

; ---- first-run configuration: a DHCP config is written only if none
; ---- exists; the wizard offer is expert-only (novice: never asked,
; ---- a note is written instead) ------------------------------------------
(if (not (exists "DEVS:tolunnet.config" (noreq)))
  (textfile
    (dest "DEVS:tolunnet.config")
    (append "DEVICE=ethernet.device\nUNIT=0\nDHCP=YES\n")
  )
)
(set #run-setup 0)
(if (> @user-level 0)
  (set #run-setup
    (askbool
      (prompt "Run SYS:Prefs/TolunnetSetup now to configure your network? (You can start it any time later from SYS:Prefs.)")
      (default 0)
      (help "tolunnet works out of the box with DHCP; the setup tool configures devices, wireless and static addresses.")
    )
  )
)
(if (= @user-level 0)
  (textfile
    (dest "T:tolunnet-install-note.txt")
    (append "Novice install: SYS:Prefs/TolunnetSetup was not run. Start it any time from SYS:Prefs to configure the network.\n")
  )
)
(if (> @user-level 0)
  (if (= #run-setup 1)
    (run "SYS:Prefs/TolunnetSetup")
  )
)

(exit "tolunnet installation complete. The stack starts automatically at next boot; configure it any time with SYS:Prefs/TolunnetSetup." (quiet))
