config_description=tolunnet conformance bench — A1200/68020 (Round 3 B.3)
use_gui=no
kickstart_rom_file=E:\amiga\Shared\rom\amiga-os-310-a1200.rom
chipset=aga
chipset_compatible=A1200
ide=a600/a1200
cpu_type=68ec020
cpu_model=68020
cpu_compatible=true
cpu_24bit_addressing=true
cpu_speed=max
chipmem_size=4
fastmem_size=8
ntsc=false

; Bench HDF copy staged by ci/bench.sh (never the pristine image)
hardfile2=rw,DH0:E:\amiga\Amigatolon\bench\tolunnet\wb30-a1200.hdf,32,1,2,512,0,,uae0
uaehf0=hdf,rw,DH0:"E:\amiga\Amigatolon\bench\tolunnet\wb30-a1200.hdf",32,1,2,512,0,,uae0

; Host dir mounted as WORK: (logs survive the run)
filesystem2=rw,WORK:Work:E:\amiga\Amigatolon\work,-128
uaehf1=dir,rw,WORK:Work:"E:\amiga\Amigatolon\work",-128

; Network: a2065 emulated card + slirp NAT (docs/bench.md)
a2065=slirp
a2065label=tolunnet

floppy0type=-1
nr_floppies=0
sound_output=none
win32.start_minimized=yes

; ANX-01: never let WinUAE provide its own bsdsocket.library -
; the bench must exercise the tolunnet stack only (gated in ci/bench.sh)
bsdsocket_emu=false
