config_description=tolunnet conformance bench — A600/68000, NTSC (Round 3 B.3)
; 68000 target for opcode/alignment proof (TNET-074/§3.5) and the NTSC
; 640x200 screen for the TolunnetPrefs compact-layout checks (TNET-062).
use_gui=no
kickstart_rom_file=E:\amiga\Shared\rom\amiga-os-310-a600.rom
chipset=ecs
chipset_compatible=A600
cpu_type=68000
cpu_compatible=true
cpu_speed=max
chipmem_size=2
; TNET-139: match real 68000 desktops (Zorro II Fast RAM). The old profile had
; bogomem only, so MEMF_ANY allocations never landed in Fast RAM during bench.
fastmem_size=4
bogomem_size=4
ntsc=true

; Bench HDF copy staged by ci/bench.sh (never the pristine image)
hardfile2=rw,DH0:E:\amiga\Amigatolon\bench\tolunnet\wb30-68000.hdf,32,1,2,512,0,,uae0
uaehf0=hdf,rw,DH0:"E:\amiga\Amigatolon\bench\tolunnet\wb30-68000.hdf",32,1,2,512,0,,uae0

; Host dir mounted as WORK: (logs survive the run)
filesystem2=rw,WORK:Work:E:\amiga\Amigatolon\work,-128
uaehf1=dir,rw,WORK:Work:"E:\amiga\Amigatolon\work",-128

; Network: a2065 emulated card + slirp NAT (docs/bench.md)
a2065=slirp
a2065label=tolunnet

floppy0type=-1
nr_floppies=0
sound_output=none
win32.start_minimized=yes

; ANX-01: never let WinUAE provide its own bsdsocket.library -
; the bench must exercise the tolunnet stack only (gated in ci/bench.sh)
bsdsocket_emu=false
