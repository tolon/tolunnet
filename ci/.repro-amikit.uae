config_description=tolunnet owner-machine repro — AmiKit distribution + PiStorm-class CPU
; Reproduces the owner's A500+PiStorm environment as closely as WinUAE
; allows: AmiKit.hdf as the boot volume, 68ec020 + Fast RAM, Kickstart 3.1
; (A1200 ROM for AGA so AmiKit renders), package dir mounted as DH1 PACK:.
; The install/wizard flow is then driven manually with the WinUAE debugger
; armed (ci/debugger) to catch the reported #80000003 at its PC.
use_gui=no
kickstart_rom_file=E:\amiga\Shared\rom\amiga-os-310-a1200.rom
chipset=aga
cpu_type=68ec020
cpu_compatible=true
cpu_speed=max
chipmem_size=4
fastmem_size=8
ntsc=false

hardfile2=rw,DH0:E:\amiga\amikit\AmiKit.hdf,32,1,2,512,0,,uae0
uaehf0=hdf,rw,DH0:"E:\amiga\amikit\AmiKit.hdf",32,1,2,512,0,,uae0

; Release package staged on the host, mounted read-write as PACK:
filesystem2=rw,PACK:Work:D:\Projeler\tolunnet\build\release\tolunnet,-130
uaehf1=dir,rw,PACK:Work:"D:\Projeler\tolunnet\build\release\tolunnet",-130

; Logs survive on WORK:
filesystem2=rw,WORK:Work:E:\amiga\Amigatolon\work,-128
uaehf2=dir,rw,WORK:Work:"E:\amiga\Amigatolon\work",-128

floppy0type=-1
nr_floppies=0
sound_output=none
win32.start_minimized=no
bsdsocket_emu=false
