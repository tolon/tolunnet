;BEGIN tolunnet soak (RC3 item 3)
; Daemon up, then a 24 h driver loop: wget every 30 s, ping every 10 s,
; TolunnetControl STATUS (STATS via STATUS) every 10 min into the log.
Stack 32768

If EXISTS WORK:
  Delete >NIL: WORK:soak.log QUIET
  Delete >NIL: WORK:bench-done QUIET

  Run >WORK:soak-daemon.log C:tolunnet
  Wait 15

  ; baseline memory snapshot
  Avail >WORK:soak-avail-base.txt

  SetParam SOAK_SECS 86400
  SetParam SOAK_T 0
  SetParam SOAK_TICK 0

  Loop
    ; ---- every ~10 s: ping burst ----
    C:TolunnetPing 127.0.0.1 COUNT=4 INTERVAL=1 QUIET >>WORK:soak.log
    If WARN
      Echo >>WORK:soak.log "SOAK: ping FAILED at $SOAK_T s"
    EndIf

    ; ---- every ~30 s: wget loopback sanity (connection-refused is fine,
    ;      the point is socket churn + TCP state) ----
    If $SOAK_TICK EQ 0
      C:TolunnetGet http://127.0.0.1:1/ >>WORK:soak.log
      ; RC 10 (connect refused) is the expected healthy outcome
    EndIf

    ; ---- every 10 min: status + Avail ----
    If $SOAK_TICK EQ 0
      C:TolunnetControl STATUS >>WORK:soak.log
      Avail >>WORK:soak.log
    EndIf

    SetParam SOAK_TICK ($SOAK_TICK + 1)
    If $SOAK_TICK GE 3
      SetParam SOAK_TICK 0
    EndIf

    SetParam SOAK_T ($SOAK_T + 10)
    If $SOAK_T GE $SOAK_SECS
      Echo >WORK:bench-done "soak complete"
      Quit
    EndIf
    Wait 10
  EndLoop
EndIf
;END tolunnet
