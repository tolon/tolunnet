;BEGIN tolunnet soak (RC3 item 3)
; Daemon up, then an endless driver loop (no variables - this WB has no
; Set/Eval; Lab/Skip BACK + If EXISTS only). Each pass is ~30 s:
; ping x3, wget (10.0.2.2:1 - slirp RSTs fast) + STATUS + Avail once.
; The host wrapper stops the run at the time budget; WORK:soak-stop is
; the manual emergency exit.
Stack 32768

If EXISTS WORK:
  Delete >NIL: WORK:soak.log QUIET
  Delete >NIL: WORK:soak-stop QUIET
  Delete >NIL: WORK:bench-done QUIET

  Run >WORK:soak-daemon.log C:tolunnet
  Wait 15

  Avail >WORK:soak-avail-base.txt

Lab soak_loop
  C:TolunnetPing 127.0.0.1 COUNT=4 INTERVAL=1 QUIET >>WORK:soak.log
  If EXISTS WORK:soak-stop
    Echo >WORK:bench-done "soak stopped by marker"
    Quit
  EndIf
  Wait 10

  C:TolunnetPing 127.0.0.1 COUNT=4 INTERVAL=1 QUIET >>WORK:soak.log
  If EXISTS WORK:soak-stop
    Echo >WORK:bench-done "soak stopped by marker"
    Quit
  EndIf
  Wait 10

  C:TolunnetPing 127.0.0.1 COUNT=4 INTERVAL=1 QUIET >>WORK:soak.log
  C:TolunnetGet http://10.0.2.2:1/ >>WORK:soak.log
  Avail >>WORK:soak.log
  Wait 10
  Skip soak_loop BACK
EndIf
;END tolunnet
