If WARN
  Echo >>WORK:soak.log "not ok soak START"
Else
  Echo >>WORK:soak.log "ok soak START"
EndIf
Wait 7
Echo >>WORK:soak.log "--- AVAIL AFTER START ---"
Avail >>WORK:soak.log
