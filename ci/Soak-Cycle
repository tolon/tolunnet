;BEGIN tolunnet 10-minute soak cycle (traffic + STATS + stop/start)
; 19 blocks of ~30 s = ~570 s traffic, followed by stats and stop/start cycle.
; 9.5: the traffic crosses SANA-II (ping the slirp gateway 10.0.2.2, GET
; from the netsvc HTTP service on the host); every command's RC is checked
; and logged as an "ok soak ..." / "not ok soak ..." line that ci/bench.sh
; counts (78 ok lines per cycle). __HTTP_PORT__ is substituted by
; ci/bench.sh from ci/netsvc.ports.
FailAt 21

; Block 1
C:TolunnetPing 10.0.2.2 COUNT=1 INTERVAL=1 >>WORK:soak.log
If WARN
  Echo >>WORK:soak.log "not ok soak ping 10.0.2.2 (block 1)"
Else
  Echo >>WORK:soak.log "ok soak ping"
EndIf
Wait 10
C:TolunnetPing 10.0.2.2 COUNT=1 INTERVAL=1 >>WORK:soak.log
If WARN
  Echo >>WORK:soak.log "not ok soak ping 10.0.2.2 (block 1)"
Else
  Echo >>WORK:soak.log "ok soak ping"
EndIf
Wait 10
C:TolunnetPing 10.0.2.2 COUNT=1 INTERVAL=1 >>WORK:soak.log
If WARN
  Echo >>WORK:soak.log "not ok soak ping 10.0.2.2 (block 1)"
Else
  Echo >>WORK:soak.log "ok soak ping"
EndIf
Wait 8
C:TolunnetGet http://10.0.2.2:__HTTP_PORT__/soak TO NIL: >>WORK:soak.log
If WARN
  Echo >>WORK:soak.log "not ok soak http get (block 1)"
Else
  Echo >>WORK:soak.log "ok soak http"
EndIf
Wait 2
If EXISTS WORK:soak-stop
  Quit
EndIf

