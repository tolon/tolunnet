;BEGIN tolunnet conformance bench (Round 3 B.3)
; ---- 10d item 1: undo sandbox (built and run in the boot context -
; ---- the row later only verifies; see QUESTIONS [auto] #8) -----------
makedir T:tnsbx
makedir T:tnsbx/C
makedir T:tnsbx/Storage
makedir T:tnsbx/Storage/tolunnet-backup
makedir T:tnsbx/Storage/tolunnet-backup/C
makedir T:tnsbx/S
makedir T:tnsbx/LIBS
makedir T:tnsbx/DEVS
Copy >NIL: SYS:C/NetShutdown T:tnsbx/C/NetShutdown CLONE
Copy >NIL: SYS:C/nc T:tnsbx/C/nc CLONE
Echo ROADSHW >T:tnsbx/Storage/tolunnet-backup/C/NetShutdown
Echo orig >T:tnsbx/S/User-Startup.tolunnet-bak
Echo rs >T:tnsbx/LIBS/bsdsocket.library.pre-tolunnet
Execute S:tolunnet-undo-sandbox
; Staged into the bench HDF by ci/bench.sh. Two full start/conformance/stop
; cycles prove the TNET-059/060 restart path; logs land on WORK: (host dir).

Stack 32768

If EXISTS WORK:
  Delete >NIL: WORK:conformance.log QUIET
  Delete >NIL: WORK:conformance2.log QUIET
  Delete >NIL: WORK:bsdsocktest.log QUIET
  Delete >NIL: WORK:bench-done QUIET

  ; ---- cycle 1 ----------------------------------------------------------
  Run >WORK:daemon.log C:tolunnet
  Wait 15

  ; ---- ANX-01: third-party bsdsocktest, before SocketConformance -------
  ; Runs on the fresh cycle-1 daemon (pristine bench config). It must NOT
  ; run after the cycles: the wizard test inside SocketConformance rewrites
  ; DEVS:tolunnet.config and the daemon stop/restart race leaves a window
  ; where a fresh daemon provides no bsdsocket.library (bench incident
  ; 20260909-154725). Loopback tier only (hermetic, no host helper); its
  ; failures do NOT gate the bench - they are recorded row-by-row in
  ; ISSUES.md.
  C:bsdsocktest LOOPBACK NOPAGE LOG WORK:bsdsocktest.log
  Wait 2

  C:SocketConformance >WORK:conformance.log
  ; SocketConformance signals the daemon to stop on exit (TNET-059 guard:
  ; refuses while clients are open — the conformance suite closes them all)
  Wait 4
  ; TN_DIAG crash capture (TNET-139): preserve any trap log before restart
  If EXISTS RAM:tolunnet-crash.log
    Copy RAM:tolunnet-crash.log WORK:tolunnet-crash.log CLONE
  EndIf


  ; ---- cycle 2: restart without reboot (TNET-059/060 proof) -------------
  Run >WORK:daemon2.log C:tolunnet
  Wait 15
  C:SocketConformance >WORK:conformance2.log
  Wait 4
  If EXISTS RAM:tolunnet-crash.log
    Copy RAM:tolunnet-crash.log WORK:tolunnet-crash2.log CLONE
  EndIf

  Echo >WORK:bench-done "bench complete"
EndIf
;END tolunnet
