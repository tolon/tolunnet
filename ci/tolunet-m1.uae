config_description=tolunet M1 exit test (SANA-II over a2065+slirp)
use_gui=no
kickstart_rom_file=E:\amiga\Shared\rom\amiga-os-310-a1200.rom
ide_mb_rom_file=:ENABLED
pcmcia_mb_rom_file=:ENABLED
chipset=aga
chipset_compatible=A1200
ide=a600/a1200
pcmcia=true
eclocksync=Gayle
cpu_type=68ec020
cpu_model=68020
cpu_compatible=true
cpu_24bit_addressing=true
cpu_speed=max
chipmem_size=4
fastmem_size=8
hardfile2=rw,DH0:E:\amiga\Amigatolon\hdf\Workbench v3.0 (1992)(Commodore).hdf,32,1,2,512,0,,uae0
uaehf0=hdf,rw,DH0:"E:\amiga\Amigatolon\hdf\Workbench v3.0 (1992)(Commodore).hdf",32,1,2,512,0,,uae0

; Network: a2065 emulated card + slirp NAT (§8 bench NIC).
a2065=slirp
a2065label=tolunet

floppy0type=-1
nr_floppies=0
